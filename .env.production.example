# ==============================================================================
# TypeKitTools.com - Production Environment Configuration Template
# Copy this file to .env.production on your Linux VPS and configure securely.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Base Canonical Domain URL
NEXT_PUBLIC_APP_URL=https://typekittools.com
NEXT_PUBLIC_SITE_NAME=TypeKitTools

# PostgreSQL Database Connection
# In Docker Compose, the database host is 'db'
DATABASE_URL=postgresql://typekit_admin:ChangeMeSecurePassword2026!@db:5432/typekit_db?schema=public

# PostgreSQL Container Credentials
POSTGRES_DB=typekit_db
POSTGRES_USER=typekit_admin
POSTGRES_PASSWORD=ChangeMeSecurePassword2026!

# Administrative Security & Sessions
# Generate with: openssl rand -base64 32
ADMIN_SECRET_KEY=generate_a_random_32_character_cryptographic_key_here!
ADMIN_SESSION_COOKIE=tkt_admin_session

# Google AdSense Monetization
NEXT_PUBLIC_ENABLE_ADS=true
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Google Analytics 4 (GA4) Integration
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Backup Retention (Days to keep automated dumps on disk)
BACKUP_KEEP_DAYS=14

